# The fixture caps changelog pages at 2 entries: 6 entries = 3 pages.
query I
SELECT count(*) FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/issue/ENG-2/changelog');
----
3

# Cycle time: hours ENG-2 spent In Progress (two stints: 9/15→10/1 and 10/3→10/8).
query R
SELECT round(sum(datediff('second', changed_at::TIMESTAMP, next_at::TIMESTAMP)) / 3600, 1) FROM (SELECT changed_at, to_string, lead(changed_at) OVER (ORDER BY changed_at) AS next_at FROM jira.main.issue_changelog(issue_key := 'ENG-2') WHERE field = 'status') WHERE to_string = 'In Progress';
----
507.0

# Without keys: every issue the JQL matches (WHERE issue_key IN … also selects issues).
query TI
SELECT issue_key, count(*) FROM jira.main.issue_changelog(jql := 'project = OPS') WHERE field = 'status' GROUP BY ALL ORDER BY 1;
----
OPS-1	2

query TI
SELECT issue_key, count(*) FROM jira.main.issue_changelog() WHERE issue_key IN ('ENG-1', 'ENG-3', 'NOPE-1') GROUP BY ALL ORDER BY 1;
----
ENG-1	1
ENG-3	2

