# A sprint's issues and how many are done.
query II
SELECT count(*) FILTER (WHERE state = 'closed'), count(*) FROM jira.main.issues() WHERE list_contains(sprint_ids, (SELECT id FROM jira.main.sprints(board_id := 1) WHERE state = 'active'));
----
1	3

