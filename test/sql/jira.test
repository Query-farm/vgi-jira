# name: test/sql/jira.test
# description: SQL tests for the jira worker against the offline Atlassian replay server (test/mock_api/server.py)
# group: [jira]

require vgi

require-env JIRA_WORKER

require-env JIRA_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

# No ICU in the test runner: TIMESTAMPTZ values print in UTC.
statement ok
ATTACH 'jira' (TYPE vgi, LOCATION '{JIRA_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM jira.main.issues();
----
<REGEX>:.*no atlassian secret.*

statement ok
CREATE SECRET bad_token (TYPE atlassian, SITE_URL '{JIRA_FIXTURE_URL}/cloud', EMAIL 'ada@example.com', API_TOKEN 'wrong');

statement error
SELECT count(*) FROM jira.main.issues();
----
<REGEX>:.*HTTP 401.*

statement ok
DROP SECRET bad_token;

statement ok
CREATE SECRET insecure (TYPE atlassian, SITE_URL 'http://acme.atlassian.net', EMAIL 'a@b.c', API_TOKEN 'x');

statement error
SELECT count(*) FROM jira.main.statuses;
----
<REGEX>:.*must use https.*

statement ok
DROP SECRET insecure;

statement ok
CREATE SECRET no_cred (TYPE atlassian, SITE_URL '{JIRA_FIXTURE_URL}/cloud', EMAIL 'ada@example.com');

statement error
SELECT count(*) FROM jira.main.statuses;
----
<REGEX>:.*EMAIL \+ API_TOKEN.*

statement ok
DROP SECRET no_cred;

# The API token is redacted in duckdb_secrets().
statement ok
CREATE SECRET cloud (TYPE atlassian, SITE_URL '{JIRA_FIXTURE_URL}/cloud', EMAIL 'ada@example.com', API_TOKEN 'cloud-token');

query I
SELECT secret_string LIKE '%cloud-token%' FROM duckdb_secrets() WHERE name = 'cloud';
----
false

# ======================================================================= Jira Cloud

query TTTTTT
SELECT key, title, state, status, assignee, labels FROM jira.main.issues() ORDER BY key;
----
ENG-1	Search revamp	open	In Progress	acc-ada	[search]
ENG-2	Index documents	closed	Done	acc-ada	[backend, search]
ENG-3	Crash on empty query	open	In Review	acc-grace	[backend]
ENG-4	Search UI	open	To Do	NULL	[frontend]
ENG-5	Typo in "Settings" page	closed	Done	acc-linus	[]
ENG-6	Add regression test	open	In Progress	acc-ada	[]
ENG-7	Upgrade dependencies	open	To Do	acc-grace	[backend, chore]
OPS-1	Rotate certificates	closed	Done	acc-grace	[]
OPS-2	Investigate 'disk full' alerts	open	In Progress	acc-ada	[incident]
OPS-3	Onboard new hire	open	To Do	NULL	[]

# An unfiltered scan still sends a bounded JQL (enhanced search rejects unbounded ones),
# and only the projected fields (plus key) are requested.
query TT
SELECT query::JSON->>'jql', query::JSON->>'fields' FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') ORDER BY seq DESC LIMIT 1;
----
created >= "1970-01-01" ORDER BY key ASC	key,summary,status,assignee,labels

# Typed columns and the tracker-neutral ones.
query TITTTTTTTTT
SELECT repo, number, id::VARCHAR, project_name, issue_type, is_subtask, priority, resolution, user_login, reporter_display_name, assignee_display_name FROM jira.main.issues() WHERE key = 'ENG-2';
----
ENG	2	10002	Engineering	Story	false	High	Done	acc-grace	Grace Hopper	Ada Lovelace

query TTTTTTTT
SELECT assignees, components, fix_versions, parent_key, parent_summary, sprint_ids, sprint_names, due_date FROM jira.main.issues() WHERE key IN ('ENG-2', 'ENG-3') ORDER BY key;
----
[acc-ada]	[Backend]	[1.0]	ENG-1	Search revamp	[1, 2]	[ENG Sprint 1, ENG Sprint 2]	NULL
[acc-grace]	[Backend]	[]	NULL	NULL	[2]	[ENG Sprint 2]	2026-11-20

query IIIIITTT
SELECT original_estimate_seconds, remaining_estimate_seconds, time_spent_seconds, votes, watches, created_at, updated_at, closed_at FROM jira.main.issues() WHERE key = 'ENG-2';
----
43200	7200	36000	2	3	2026-09-10 09:00:00+00	2026-10-10 16:30:00+00	2026-10-10 16:30:00+00

query TT
SELECT body, html_url = '{JIRA_FIXTURE_URL}/cloud/browse/ENG-3' FROM jira.main.issues() WHERE key = 'ENG-3';
----
Steps: search for @Ada Lovelace with nothing.	true

# ADF lists and marks flatten to text; the raw ADF stays available as JSON.
query TT
SELECT replace(body, chr(10), ' | '), description_adf->>'$.content[1].type' FROM jira.main.issues() WHERE key = 'ENG-1';
----
Replace the legacy search with Elastic. | - indexing | - query UI	bulletList

# ---------------------------------------------------------------- JQL pushdown

query T
SELECT key FROM jira.main.issues() WHERE project_key = 'ENG' AND state = 'open' AND list_contains(labels, 'backend') ORDER BY key;
----
ENG-3
ENG-7

query TT
SELECT query::JSON->>'jql', query::JSON->>'fields' FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') ORDER BY seq DESC LIMIT 1;
----
project = "ENG" AND statusCategory != Done AND labels = "backend" ORDER BY key ASC	key,project,status,labels

query T
SELECT key FROM jira.main.issues() WHERE state = 'closed' ORDER BY key;
----
ENG-2
ENG-5
OPS-1

query T
SELECT query::JSON->>'jql' FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') ORDER BY seq DESC LIMIT 1;
----
statusCategory = Done ORDER BY key ASC

# IN lists, IS NULL → is EMPTY, and a widened time range (re-checked exactly).
query T
SELECT key FROM jira.main.issues() WHERE issue_type IN ('Bug', 'Story') AND created_at >= TIMESTAMPTZ '2026-10-02 08:15:00+00' AND assignee IS NULL;
----
ENG-4

query T
SELECT query::JSON->>'jql' FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') ORDER BY seq DESC LIMIT 1;
----
issuetype in ("Bug", "Story") AND created >= "2026-10-01 06:15" AND assignee is EMPTY ORDER BY key ASC

# The widened JQL range let ENG-3 (created exactly at the bound) and ENG-2 through
# the server; the SDK re-applies the exact SQL predicate.
query T
SELECT key FROM jira.main.issues() WHERE created_at > TIMESTAMPTZ '2026-10-02 08:15:00+00' AND project_key = 'ENG' AND issue_type = 'Bug' ORDER BY key;
----
ENG-5

query T
SELECT key FROM jira.main.issues() WHERE assignee = 'acc-ada' AND priority = 'High' AND status_category = 'In Progress' ORDER BY key;
----
ENG-1
OPS-2

query T
