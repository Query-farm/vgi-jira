# OR is not translated (it is re-checked by the SDK instead).
query T
SELECT key FROM jira.main.issues() WHERE key = 'OPS-1' OR title = 'Search UI' ORDER BY key;
----
ENG-4
OPS-1

query T
SELECT query::JSON->>'jql' FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') ORDER BY seq DESC LIMIT 1;
----
created >= "1970-01-01" ORDER BY key ASC

# The jql argument is ANDed with the pushed clauses and keeps its own ORDER BY.
query T
SELECT key FROM jira.main.issues(jql := 'summary ~ "search" ORDER BY created DESC') WHERE project_key = 'ENG';
----
ENG-4
ENG-1

query T
SELECT query::JSON->>'jql' FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') ORDER BY seq DESC LIMIT 1;
----
(summary ~ "search") AND project = "ENG" ORDER BY created DESC

query T
SELECT key FROM jira.main.issues(jql := 'sprint in openSprints() AND issuetype in subTaskIssueTypes()');
----
ENG-6

# A bad JQL comes back as the server's 400.
statement error
SELECT count(*) FROM jira.main.issues(jql := 'project = ENG AND bogus = 1');
----
<REGEX>:.*HTTP 400.*bogus.*

statement error
SELECT count(*) FROM jira.main.issues(page_size := 500);
----
<REGEX>:.*page_size.*

# nextPageToken paging: page_size 3 → 4 requests for 10 issues, all rows once.
query II
SELECT count(*), count(DISTINCT key) FROM jira.main.issues(jql := 'ORDER BY key', page_size := 3);
----
10	10

query I
SELECT count(*) FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') WHERE query::JSON->>'maxResults' = '3';
----
4

query I
SELECT count(*) FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') WHERE query::JSON->>'nextPageToken' IS NOT NULL AND query::JSON->>'maxResults' = '3';
----
3

# ------------------------------------------------------------------ custom fields

query TT
SELECT key, custom_fields FROM jira.main.issues() WHERE key IN ('OPS-1', 'ENG-3') ORDER BY key;
----
ENG-3	{"Story point estimate":3,"Sprint":[{"id":2,"state":"active","name":"ENG Sprint 2","startDate":"2026-11-02T09:00:00.000Z","endDate":"2026-11-16T09:00:00.000Z","createdDate":"2026-10-28T09:00:00.000Z","originBoardId":1,"goal":"Ship search","boardId":1}]}
OPS-1	{"Team":{"id":"opt-SRE","value":"SRE"},"Customer Tier":"Gold"}

statement ok
ATTACH 'jira' AS jh (TYPE vgi, LOCATION '{JIRA_WORKER}', custom_fields 'story_points=Story point estimate:DOUBLE, team=customfield_10030, tier=Customer Tier, sprints=Sprint:VARCHAR[]');

query TRTTT
SELECT key, story_points, team, tier, sprints FROM jh.main.issues() WHERE story_points >= 4 ORDER BY key;
----
ENG-2	5.0	NULL	NULL	[ENG Sprint 1, ENG Sprint 2]
ENG-4	8.0	NULL	NULL	[ENG Sprint 3]

query TT
SELECT query::JSON->>'jql', query::JSON->>'fields' FROM read_json('{JIRA_FIXTURE_URL}/__requests?path=/cloud/rest/api/3/search/jql') ORDER BY seq DESC LIMIT 1;
----
cf[10016] >= 4 ORDER BY key ASC	key,customfield_10016,customfield_10030,customfield_10040,customfield_10020

query TT
SELECT key, team FROM jh.main.issues() WHERE team = 'SRE' ORDER BY key;
----
OPS-1	SRE
OPS-2	SRE

query T
SELECT column_type FROM (DESCRIBE SELECT story_points FROM jh.main.issues());
----
DOUBLE

statement ok
DETACH jh;

statement ok
ATTACH 'jira' AS jbad (TYPE vgi, LOCATION '{JIRA_WORKER}', custom_fields 'x=No Such Field:DOUBLE');

statement error
SELECT x FROM jbad.main.issues();
----
<REGEX>:.*no Jira field named 'No Such Field'.*

statement ok
DETACH jbad;

